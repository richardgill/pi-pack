{
  "name": "pi-pack",
  "version": "0.0.1",
  "description": "A CLI tool for managing Git patch workflows.",
  "type": "module",
  "bin": {
    "pi-pack": "./bin/pi-pack.cjs"
  },
  "files": [
    "bin",
    "schema.json",
    "assets"
  ],
  "scripts": {
    "build": "bun run ./scripts/build.ts",
    "build-single": "bun run ./scripts/build.ts --single",
    "check": "bun run scripts/check.ts",
    "check-fix": "biome check --write --error-on-warnings --diagnostic-level=warn",
    "misc-checks": "bun run scripts/misc-checks.ts",
    "changeset": "changeset",
    "changeset-version": "changeset version && bun run scripts/post-version-bump.ts",
    "dev": "bun run src/cli.ts",
    "knip": "knip-bun",
    "local-ci": "bun run scripts/local-ci.ts",
    "prepare": "[ \"$DEPENDABOT\" = true ] || [ -n \"$CI\" ] || lefthook install",
    "typecheck": "tsgo --noEmit",
    "test": "bun run scripts/test.ts",
    "test-watch": "bun test --watch",
    "test-coverage": "bun test --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "=2.3.10",
    "@changesets/changelog-github": "=0.5.2",
    "@changesets/cli": "=2.29.8",
    "@types/node": "=25.0.3",
    "@typescript/native-preview": "=7.0.0-dev.20260122.2",
    "bun-types": "=1.3.4",
    "knip": "=5.78.0",
    "lefthook": "=2.0.13",
    "syncpack": "=13.0.4",
    "typescript": "=5.9.3"
  },
  "dependencies": {
    "@clack/prompts": "=1.0.0-alpha.9",
    "@stricli/core": "=1.2.4",
    "chalk": "=5.6.2",
    "es-toolkit": "=1.43.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.4"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "license": "MIT",
  "repository": {
    "url": "https://github.com/richardgill/pi-pack"
  },
  "optionalDependencies": {
    "pi-pack-darwin-arm64": "=0.0.27",
    "pi-pack-darwin-x64": "=0.0.27",
    "pi-pack-linux-arm64": "=0.0.27",
    "pi-pack-linux-x64": "=0.0.27",
    "pi-pack-windows-x64": "=0.0.27"
  },
  "publishConfig": {
    "access": "public"
  }
}
