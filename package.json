{
  "name": "pi-pack",
  "version": "0.0.1",
  "description": "A CLI tool for managing Git patch workflows.",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/richardgill/pi-pack"
  },
  "bin": {
    "pi-pack": "./bin/pi-pack.cjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "check-fix": "vp check --fix",
    "changeset": "changeset",
    "changeset-version": "changeset version && npm install",
    "dev": "tsx src/cli.ts",
    "knip": "knip",
    "local-ci": "tsx scripts/local-ci.ts",
    "misc-checks": "tsx scripts/misc-checks.ts",
    "prepare": "[ \"$DEPENDABOT\" = true ] || [ -n \"$CI\" ] || git config core.hooksPath .vite-hooks || true",
    "publish-package": "tsx scripts/publish.ts",
    "test": "vp test",
    "test-coverage": "vp test run --coverage",
    "test-watch": "vp test watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "=1.2.0",
    "@stricli/core": "=1.2.6"
  },
  "devDependencies": {
    "@changesets/changelog-github": "=0.6.0",
    "@changesets/cli": "=2.31.0",
    "@types/node": "=25.6.0",
    "knip": "=6.6.3",
    "syncpack": "=14.3.0",
    "tsx": "=4.21.0",
    "typescript": "=6.0.3",
    "vite-plus": "=0.1.19"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.13.0"
}
