{
  "name": "pi-pack",
  "version": "0.0.11",
  "description": "pi extension installer",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/richardgill/pi-pack.git"
  },
  "bin": {
    "pi-pack": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "check-fix": "vp check --fix",
    "changeset": "changeset",
    "changeset-version": "changeset version && npm install",
    "dev": "tsx src/cli.ts",
    "knip": "knip",
    "local-ci": "tsx scripts/local-ci.ts",
    "misc-checks": "tsx scripts/misc-checks.ts",
    "prepare": "[ \"$DEPENDABOT\" = true ] || [ -n \"$CI\" ] || git config core.hooksPath .vite-hooks || true",
    "publish-package": "tsx scripts/publish.ts",
    "test": "vp test",
    "test-coverage": "vp test run --coverage",
    "test-watch": "vp test watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "=1.4.0",
    "@mariozechner/pi-coding-agent": "=0.73.1",
    "@stricli/core": "=1.2.7",
    "chalk": "=5.6.2",
    "pnpm": "=10.33.2"
  },
  "devDependencies": {
    "@changesets/changelog-github": "=0.7.0",
    "@changesets/cli": "=2.31.0",
    "@types/node": "=25.6.0",
    "knip": "=6.14.1",
    "tsx": "=4.22.3",
    "typescript": "=6.0.3",
    "vite-plus": "=0.1.22"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.13.0"
}
