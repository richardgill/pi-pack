{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/**/*.{unit,e2e}.test.ts", "scripts/*.ts", "vite.config.ts"],
  "project": ["src/**/*.ts", "scripts/**/*.ts"],
  "ignoreDependencies": ["@clack/prompts", "syncpack"],
  "ignore": [
    "src/lib/env.ts",
    "src/lib/exit.ts",
    "src/lib/prompts.ts",
    "src/testing/prompt-testing-types.ts",
    "src/version.ts"
  ],
  "ignoreExportsUsedInFile": {
    "type": true
  }
}
