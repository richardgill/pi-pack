{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/**/*.{unit,e2e}.test.ts", "scripts/*.ts"],
  "project": ["src/**/*.ts", "scripts/**/*.ts"],
  "lefthook": false,
  "ignoreBinaries": ["tar", "sha256sum"],
  "ignoreDependencies": ["@clack/prompts", "es-toolkit"],
  "ignore": [
    "src/lib/env.ts",
    "src/lib/exit.ts",
    "src/lib/prompts.ts",
    "src/testing/prompt-testing-types.ts",
    "src/version.ts"
  ],
  "ignoreExportsUsedInFile": {
    "type": true
  }
}
